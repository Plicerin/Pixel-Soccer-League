{
  "name": "pixel-soccer-league",
  "private": true,
  "version": "0.6.2",
  "type": "module",
  "bin": {
    "psl": "./scripts/psl.mjs"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "node scripts/preview.mjs",
    "tauri:dev": "npx @tauri-apps/cli dev",
    "tauri:build": "npx @tauri-apps/cli build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "sim:headless": "node scripts/headless-sim.mjs",
    "sim:match": "node scripts/headless-sim.mjs --games 1",
    "sim:smoke": "node scripts/headless-sim.mjs --games 1 --mode smoke",
    "sim:goalkick": "node --import tsx scripts/goalkick-sim.mjs",
    "sim:simple-kpi": "node --import tsx scripts/simple-model-kpi.mjs",
    "sim:fifa-calibrate": "node --import tsx scripts/fifa-calibration.mjs",
    "sim:browser": "node scripts/browser-harness-fixture.mjs",
    "sim:worldcup": "node scripts/worldcup-browser-smoke.mjs",
    "perf:browser": "node scripts/browser-load-profile.mjs",
    "db:prune": "node scripts/prune-match-history.mjs 10",
    "sim:probe-gpu": "node scripts/probe-headless-gpu.mjs",
    "browser:open": "node scripts/open-debug-browser.mjs",
    "sim:headless:5": "node scripts/headless-sim.mjs --quantity 5",
    "sim:headless:10": "node scripts/headless-sim.mjs --quantity 10",
    "sim:headless:20": "node scripts/headless-sim.mjs --quantity 20",
    "telemetry:analyze": "node --import tsx scripts/telemetry-analyze-latest.mjs",
    "telemetry:review": "node --import tsx scripts/telemetry-review.mjs",
    "movement:real": "node scripts/analyze-real-movement-profile.mjs",
    "iterate:overnight": "node scripts/iterate-overnight.mjs",
    "tuning:series": "node scripts/iterate-overnight.mjs --cycles 5 --games-per-cycle 1 --mode tuning --speed 1 --half-seconds 300",
    "hours": "node scripts/project-hours.mjs",
    "hours:report": "node scripts/update-project-hours-report.mjs",
    "hours:start": "node scripts/project-hours.mjs start",
    "hours:stop": "node scripts/project-hours.mjs stop",
    "hours:status": "node scripts/project-hours.mjs status",
    "self-edit:loop": "node scripts/self-edit-loop.mjs",
    "tuning:scoreboard": "node scripts/tuning-scoreboard.mjs",
    "eval:cycle": "node scripts/eval-cycle.mjs",
    "eval:guard": "node --import tsx scripts/simple-model-kpi.mjs --guard simple-kpi",
    "release": "node scripts/release.mjs",
    "eval:defense": "node --import tsx scripts/defense-harness.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "@tailwindcss/vite": "^4.1.14",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.8.0",
    "dexie": "^4.4.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.183.2",
    "troika-three-text": "^0.52.4",
    "vite": "^6.2.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "playwright-core": "^1.59.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
